# ==============================================================================
# @Splittel Remote MCP Server — Enterprise Environment Configuration
# ==============================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3443
HTTPS_ENABLED=true
TRUST_PROXY=true

# Public HTTPS URL advertised in OAuth 2.1 Protected Resource Metadata & Payment Links
PUBLIC_BASE_URL=https://localhost:3443

# Optional custom TLS certificate paths (auto-generates self-signed dev cert in ./certs if omitted)
TLS_CERT_PATH=./certs/localhost-cert.pem
TLS_KEY_PATH=./certs/localhost-key.pem

# Local Infrastructure (OrbStack Defaults)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/splittel
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
STORAGE_DRIVER=auto

# Cloudflare R2 / AWS S3 Object Storage (Receipt Photos — only CDN URLs saved to DB)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET_NAME=splittel-receipts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Security, Rate Limiting & JWT Secret Isolation
JWT_SECRET=splittel-prod-grade-hmac-sha256-signing-key-2026
OAUTH_JWT_SECRET=splittel-prod-grade-hmac-sha256-signing-key-2026
UI_ACTION_SECRET=splittel-sandboxed-iframe-action-hmac-key-2026
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
STRICT_ENTERPRISE_ENV=false

# OAuth 2.1 Resource Server & Built-in PKCE Authorization Server
OAUTH_ISSUER_URL=https://localhost:3443
OAUTH_AUDIENCE=https://localhost:3443/mcp
OAUTH_JWKS_URI=
OAUTH_REQUIRE_AUTH_FOR_TOOLS=true
OAUTH_ENFORCE_ON_ALL_MCP=false
